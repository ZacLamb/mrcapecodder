<%
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: s.name + ' in ' + t.name + ', MA',
      serviceType: s.name,
      provider: { '@type': 'HomeAndConstructionBusiness', name: biz.legalName, telephone: biz.phone, url: biz.url },
      areaServed: { '@type': 'City', name: t.name + ', MA' },
      description: s.summary
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map(function (f) { return { '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } }; })
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Services', item: biz.url + '/services' },
        { '@type': 'ListItem', position: 2, name: s.name, item: biz.url + s.url },
        { '@type': 'ListItem', position: 3, name: t.name, item: biz.url + s.url + '/' + t.slug }
      ]
    }
  ]
};
%>
<%- include('partials/head', { schema: schema, ogImage: s.hero }) %>
<%- include('partials/header') %>

<section class="page-hero" style="--bg:url('<%= s.hero %>')">
  <div class="wrap">
    <nav class="crumbs light" aria-label="Breadcrumb"><a href="/services">Services</a> / <a href="<%= s.url %>"><%= s.short %></a> / <span><%= t.name %></span></nav>
    <h1><%= s.name %> in <%= t.name %>, MA</h1>
    <p class="lead"><%= s.summary %> Serving <%= list(t.villages, 4) %>.</p>
    <div class="hero-actions">
      <a class="btn btn-red btn-lg" href="/contact?service=<%= s.slug %>&town=<%= t.slug %>">Book a <%= t.name %> Walk-Through</a>
      <a class="btn btn-ghost-light btn-lg" href="tel:<%= biz.phoneHref %>"><%= biz.phone %></a>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap split">
    <div class="prose">
      <h2><%= s.short %> for <%= t.name %> homeowners</h2>
      <% s.localAngle(t).forEach(function (para) { %><p><%= para %></p><% }) %>
      <p><%= s.intro %></p>

      <h2>What’s included</h2>
      <div class="incl-grid">
        <% s.sections.forEach(function (sec) { %>
          <div class="incl">
            <h3><%= sec.title %></h3>
            <ul class="checks"><% sec.items.forEach(function (it) { %><li><%= it %></li><% }) %></ul>
          </div>
        <% }) %>
      </div>

      <h2>Where we work in <%= t.name %></h2>
      <p>We serve all of <%= t.name %> (<%= t.regionLabel %>), including <%= list(t.villages, 8) %>. That includes <%= t.homes %>, and properties along <%= list(t.water, 5) %>.</p>
      <div class="chip-row"><% t.villages.forEach(function (v) { %><span class="chip"><%- include('partials/icon', { name: 'pin' }) %><%= v %></span><% }) %></div>

      <h2><%= s.short %> in <%= t.name %>: common questions</h2>
      <div class="faq">
        <% faqs.forEach(function (f) { %>
          <details><summary><%= f.q %></summary><p><%= f.a %></p></details>
        <% }) %>
      </div>
    </div>

    <aside class="side">
      <div class="side-img" style="background-image:url('<%= s.image %>')"></div>
      <div class="side-box">
        <h3>Book a walk-through in <%= t.name %></h3>
        <p>Tell us about your property and we’ll reach out within 48 hours.</p>
        <a class="btn btn-red btn-block" href="/contact?service=<%= s.slug %>&town=<%= t.slug %>">Get Started</a>
        <a class="btn btn-ghost btn-block" href="tel:<%= biz.phoneHref %>">Call <%= biz.phone %></a>
      </div>
      <div class="side-box">
        <h3>Good to know</h3>
        <ul class="dots"><% biz.policies.forEach(function (p) { %><li><%= p %></li><% }) %></ul>
      </div>
      <div class="side-box">
        <h3>More in <%= t.name %></h3>
        <ul class="link-list">
          <% otherServices.forEach(function (o) { %><li><a href="<%= o.url %>/<%= t.slug %>"><%= o.short %> in <%= t.name %></a></li><% }) %>
          <li><a href="/service-areas/<%= t.slug %>">All services in <%= t.name %> →</a></li>
        </ul>
      </div>
    </aside>
  </div>
</section>

<section class="section sand">
  <div class="wrap">
    <div class="section-head"><h2><%= s.short %> in nearby towns</h2></div>
    <div class="town-pills">
      <% nearbyTowns.forEach(function (n) { %><a class="pill" href="<%= s.url %>/<%= n.slug %>"><%= s.short %> in <%= n.name %></a><% }) %>
      <a class="pill pill-dark" href="<%= s.url %>">All <%= s.short %> towns →</a>
    </div>
  </div>
</section>

<%- include('partials/cta', { ctaTitle: 'Need ' + s.short.toLowerCase() + ' in ' + t.name + '?', ctaHref: '/contact?service=' + s.slug + '&town=' + t.slug }) %>
<%- include('partials/footer') %>
